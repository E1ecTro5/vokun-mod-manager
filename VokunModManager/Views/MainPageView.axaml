<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VokunModManager.ViewModels"
        xmlns:li="using:LoadingIndicators.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VokunModManager.Views.MainPageView"
        x:DataType="vm:MainPageViewModel">
    
    <Grid ColumnDefinitions="3*,5*" ColumnSpacing="10" Margin="10">
        <Grid Grid.Column="0">
            <ListBox Grid.Row="0"
                     Name="PluginsListBox"
                     Classes="draggable"
                     ItemsSource="{Binding ModPluginsList}"
                     BorderThickness="1"
                     BorderBrush="Black"
                     CornerRadius="10"
                     Background="Transparent"
                     DragDrop.AllowDrop="True"
                     PointerMoved="ListBox_PointerMoved">
    
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- put PointerPressed on the Grid itself to capture the whole row -->
                        <Grid ColumnDefinitions="*, Auto" Margin="4,2" Background="Transparent" 
                              PointerPressed="Row_PointerPressed"
                              PointerReleased="Row_PointerReleased">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                
                            <TextBlock Grid.Column="1" Text="{Binding LoadOrder}" VerticalAlignment="Center" 
                                       HorizontalAlignment="Right" Width="40" Margin="10,0,5,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Grid Grid.Column="1" RowDefinitions="2*, *, Auto" RowSpacing="5">
            <DataGrid AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      CanUserResizeColumns="True"
                      ItemsSource="{Binding ModList}"
                      GridLinesVisibility="All"
                      BorderThickness="1" BorderBrush="Black" CornerRadius="10">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Mod" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding InstalledFiles.Count, StringFormat='Files count: {0}'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <DataGrid Grid.Row="1" 
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      CanUserResizeColumns="True"
                      ItemsSource="{Binding SksePluginList}"
                      GridLinesVisibility="All"
                      BorderThickness="1" BorderBrush="Black" CornerRadius="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Plugin" Width="*" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Types" Width="2*" Binding="{Binding TypesToString}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <Grid Grid.Row="2" RowDefinitions="*,*" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="5">
                <Button Grid.Row="0" Grid.RowSpan="2" Classes="Main-Button" Content="Install mod" Command="{Binding InstallModCommand}" IsEnabled="{Binding IsButtonAvailable}" Grid.Column="0"></Button>
                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Classes="Main-Button" Content="Delete mod" Command="{Binding OpenDeleteModWindowCommand}" CommandParameter="{Binding $parent[Window]}" IsEnabled="{Binding IsButtonAvailable}"></Button>
                <li:LoadingIndicator Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Height="30" IsActive="{Binding IsModInstalling}" Mode="Arc" SpeedRatio="1.2" />
                <Button Grid.Row="0" Content="Save modlist" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SaveModListCommand}" IsEnabled="{Binding IsButtonAvailable}" Grid.Column="3" Padding="10,5"></Button>
                <Button Grid.Row="1" Content="Refresh lists" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding UpdateListsCommand}" IsEnabled="{Binding IsButtonAvailable}" Grid.Column="3" Padding="10,5"></Button>
                <Button Grid.Row="0" Grid.RowSpan="2" Classes="Main-Button" Content="Play" Command="{Binding StartGameCommand}" IsEnabled="{Binding IsButtonAvailable}" Grid.Column="4" ></Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
