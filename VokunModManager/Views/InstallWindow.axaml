<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="VokunModManager.Views.InstallWindow"
        Title="{Binding Type}"
        xmlns:vm="using:VokunModManager.ViewModels"
        x:DataType="vm:InstallWindowViewModel"
        SizeToContent="WidthAndHeight" 
        MaxWidth="1280"
        CanResize="False">

    <Grid RowDefinitions="Auto, Auto" Margin="10">

        <ScrollViewer Grid.Row="0" MaxHeight="600" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" x:Name="RootContainer" Orientation="Vertical">
                
                <!-- just GroupName -->
                <TextBlock Text="{Binding GroupName}" 
                           FontWeight="Bold" 
                           Margin="0,10,0,0"/>

                <!-- dynamic list -->
                <!-- 1. ВАРИАНТ ДЛЯ SINGLE SELECT (RadioButton) -->
                <ItemsControl ItemsSource="{Binding Options}" 
                              IsVisible="{Binding IsSingleSelect}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14" Orientation="Vertical">
                                <RadioButton Content="{Binding Name}" 
                                             GroupName="{Binding $parent[Window].((vm:InstallWindowViewModel)DataContext).GroupName}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding Description}" 
                                           Margin="28,4,0,0" 
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. ВАРИАНТ ДЛЯ MULTI SELECT (CheckBox) -->
                <ItemsControl ItemsSource="{Binding Options}" 
                              IsVisible="{Binding IsMultiSelect}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14" Orientation="Vertical">
                                <CheckBox Content="{Binding Name}" 
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding Description}" 
                                           Margin="28,4,0,0" 
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Select Button -->
        <StackPanel Grid.Row="1" Margin="0,15,0,0">
            <Button Content="Select" 
                    Command="{Binding SelectCommand}" 
                    HorizontalAlignment="Right" 
                    Padding="20,6"/>
        </StackPanel>

    </Grid>
</Window>