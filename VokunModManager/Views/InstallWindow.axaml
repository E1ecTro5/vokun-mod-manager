<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="VokunModManager.Views.InstallWindow"
        Title="InstallWindow"
        xmlns:vm="using:VokunModManager.ViewModels"
        x:DataType="vm:InstallWindowViewModel"
        Width="400" Height="350">
    
    <Grid RowDefinitions="*, Auto" Margin="10">
        <StackPanel x:Name="MainStackPanel" Margin="10">
            <!--just for existence, I'll rewrite this soon with bindings and etc-->
            <TextBlock Text="{Binding TextBlockContent}"/>
            <!--radiobuttons will be added here through the code-->
            <RadioButton IsChecked="True">
                <TextBlock>dadada</TextBlock>
            </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Button Content="Select" Command="{Binding SelectCommand}" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
