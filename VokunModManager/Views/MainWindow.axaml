<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VokunModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="900" MinHeight="400"
        x:Class="VokunModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/vokunIcon.ico"
        Title="Vokun Mod Manager">
    
    <Grid RowDefinitions="auto,*" Background="#14243D">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,0">
            <Button Command="{Binding SelectMainPageCommand}"
                    Content="Main Page"
                    Classes="Navbar-Button"
                    Classes.Navbar-Selected="{Binding IsMainPageSelected}"/>
            <Button Command="{Binding SelectToolsPageCommand}"
                    Content="Tools Page"
                    Classes="Navbar-Button"
                    Classes.Navbar-Selected="{Binding IsToolsPageSelected}"/>
            <Button Command="{Binding SelectSettingsPageCommand}"
                    Content="Settings Page"
                    Classes="Navbar-Button"
                    Classes.Navbar-Selected="{Binding IsSettingsPageSelected}"/>
        </StackPanel>
        <ContentControl Grid.Row="1" Background="White" Content="{Binding CurrentPage}" CornerRadius="5,5,0,0"/>
    </Grid>
</Window>
