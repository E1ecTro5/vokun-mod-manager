<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VokunModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="900" MinHeight="400"
        x:Class="VokunModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/vokunIcon.ico"
        Title="Vokun Mod Manager">
    
    <Grid RowDefinitions="auto,*">
        <StackPanel Grid.Row="0" Background="#14243D" Orientation="Horizontal">
            <Button Margin="5" Command="{Binding SelectMainPageCommand}" Content="Main Page" Foreground="White" HorizontalAlignment="Stretch" Width="160"/>
            <Button Margin="5" Command="{Binding SelectToolsPageCommand}" Content="Tools Page" Foreground="White" HorizontalAlignment="Stretch" Width="160"/>
            <Button Margin="5" Command="{Binding SelectSettingsPageCommand}" Content="Settings Page" Foreground="White" HorizontalAlignment="Stretch" Width="160"/>
        </StackPanel>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
