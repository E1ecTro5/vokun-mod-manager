<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VokunModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VokunModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VokunModManager">
    
    <Grid RowDefinitions="Auto,*"
          Margin="10"
          RowSpacing="10">
        
        <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Content="Select Game Directory" Padding="1" Command="{Binding SelectDirectoryCommand}"/>
                <Button Content="Select Plugin.txt File" Padding="1" Command="{Binding SelectFileCommand}"/>
                <Button Content="Update TextBlocks" Padding="1" Command="{Binding UpdateTextBlocksCommand}"/>
                <Button Content="Update ModList" Padding="1" Command="{Binding UpdateModListCommand}"/>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding ConfigFilePath}" VerticalAlignment="Center" Background="RosyBrown" TextWrapping="NoWrap"/>
            </ScrollViewer>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding OrigGamePath}" VerticalAlignment="Center" Background="Bisque" TextWrapping="NoWrap"/>
            </ScrollViewer>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding ModListPath}" VerticalAlignment="Center" Background="Bisque" TextWrapping="NoWrap"/>
            </ScrollViewer>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding ModGameId}" VerticalAlignment="Center" Background="Bisque" TextWrapping="NoWrap"/>
            </ScrollViewer>
        </StackPanel>
        
        <Grid Grid.Row="1" ColumnDefinitions="*,*">
            <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="10">
                <DataGrid Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          ItemsSource="{Binding ModList}"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="1" BorderBrush="Black" CornerRadius="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ModName" Width="Auto"  Binding="{Binding Name}"/>
                        <DataGridCheckBoxColumn Header="IsActive" Width="Auto"  Binding="{Binding IsEnabled}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Play" Padding="10,1"></Button>
                    <Button Content="Save" Padding="10,1"></Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
