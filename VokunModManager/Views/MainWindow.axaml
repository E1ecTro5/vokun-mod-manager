<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VokunModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="900" MinHeight="400"
        x:Class="VokunModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/vokunIcon.ico"
        Title="Vokun Mod Manager">
    
    <Grid ColumnDefinitions="auto,*">
        <StackPanel Grid.Column="0" Background="GhostWhite" Orientation="Vertical">
            <Button Margin="5" Command="{Binding SelectMainPageCommand}" Content="Main" HorizontalAlignment="Stretch"/>
            <Button Margin="5" Command="{Binding SelectToolsPageCommand}" Content="Tools" HorizontalAlignment="Stretch"/>
        </StackPanel>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
